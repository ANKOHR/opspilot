APP_ENV=development
DATABASE_URL=sqlite:///./opspilot.db
REDIS_URL=redis://localhost:6379/0
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DEMO_ORG_ID=demo-org

# App secrets. Generate a long random APP_SECRET and a Fernet key for live credentials.
APP_SECRET=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
WEB_APP_URL=http://localhost:3000

# Optional live Gmail OAuth. Leave blank to keep the deterministic sandbox.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.send

# Optional provider credentials. The local demo uses deterministic providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
